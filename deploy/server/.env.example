# Home dev server environment -- the real file is deploy/server/.env (git-ignored).
#
# Generate it with:   scripts/server-init.sh dev.<your-domain>
# (it prompts for the tunnel token and creates every secret below).
#
# Do NOT copy the laptop's root .env here: it holds the real MusicGPT API key, and this
# stack is meant to run against the simulator only.

# Public hostname served through the Cloudflare tunnel, without scheme or slash.
PUBLIC_HOSTNAME=

# Token of the named tunnel (Cloudflare dashboard -> Networks -> Tunnels -> Docker).
TUNNEL_TOKEN=

# Generated secrets. Keep them once the stack has started: the Postgres and MinIO
# volumes are initialised with these values.
POSTGRES_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SESSION_SECRET=
WEBHOOK_SECRET=
GRAFANA_ADMIN_PASSWORD=

# Optional. Simulator generation slots across the whole stack.
GLOBAL_GENERATION_CONCURRENCY=50
