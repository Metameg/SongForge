# SongForge environment — copy to `.env` and adjust. Read by the single config module
# (backend/src/songforge/config.py). docker-compose auto-loads this file.

# ── Runtime ─────────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO
# Issue #19 (PRD #6 AC#4): the web tier's bind port (`Settings.web_port`, read by
# `songforge-web`'s __main__.py). Railway (and PaaS deploys generally) injects this
# as `$PORT` to tell the container which port to listen on. LEAVE THIS LINE
# COMMENTED OUT locally/in docker-compose -- an empty `PORT=` value would fail
# `Settings` validation (it's an int), and nothing here needs to set it; it
# defaults to 8000 either way. Only a real PaaS deploy sets a real value.
# PORT=8080

# ── Host port mappings (only the port published on YOUR machine) ──────────────
# Datastores default to high, non-standard ports so a `docker compose up` never
# collides with a Postgres/Redis/MinIO you already run locally on the standard
# ports — no override needed. They do NOT affect in-cluster addressing: services
# always reach each other on the container port (e.g. postgres:5432). Bump these
# further only if you run two SongForge stacks (e.g. two worktrees) at once.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
# Issue #19 (PRD #6 AC#1): `web` no longer publishes its own host port -- traffic must
# go through the `lb` (nginx) service so N `web` replicas can't collide on one static
# host port. This is the port YOU browse to (http://localhost:8000); it forwards to
# whichever `web` replica Docker's DNS round-robins to next.
LB_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
SIMULATOR_HOST_PORT=8080

# ── Postgres (compose provisions these) ──────────────────────────────────────
POSTGRES_USER=songforge
POSTGRES_PASSWORD=songforge
POSTGRES_DB=songforge
# Async driver at runtime; Alembic derives a sync (+psycopg) URL from this. In
# docker-compose this is overridden per-service -- `web` points at `pgbouncer:6432`
# (transaction pooling), `worker`/`migrate` point directly at `postgres:5432`. This
# bare default (no pooler) is what plain `uv run songforge-web`/tests use.
DATABASE_URL=postgresql+asyncpg://songforge:songforge@postgres:5432/songforge
# Issue #19 (PRD #6 AC#2): OPTIONAL override for the worker's advisory-lock +
# LISTEN/NOTIFY connections, so they can point at Postgres directly while
# DATABASE_URL (web tier) points at PgBouncer. Leave BLANK to fall back to
# DATABASE_URL (dev/tests/single-node default -- no pooler in front). docker-compose
# doesn't need this at all (it gives `worker` its own direct DATABASE_URL override
# instead, since compose services don't share one env value) -- this exists for
# topologies where web and worker share a single DATABASE_URL value (e.g. a shared
# Railway variable group) and still need to diverge. See docs/deploy.md.
WORKER_DATABASE_URL=
# Issue #19 (PRD #6 AC#2): true when DATABASE_URL points at a PgBouncer running in
# TRANSACTION pooling mode -- disables asyncpg's server-side prepared-statement
# cache on the pooled web engine, which would otherwise silently break (a statement
# prepared against one backend session can vanish when the pooler hands the logical
# connection to a different one). Leave false when nothing pools DATABASE_URL (this
# default, and Alembic/the worker's direct connection, always leave it false).
DB_PGBOUNCER_TRANSACTION_MODE=false
# PgBouncer pool sizing (docker-compose's `pgbouncer` service only) -- placeholders,
# NOT tuned; re-tune against issue #18's k6 load-test harness once real concurrency
# numbers exist.
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (MinIO locally, Cloudflare R2 in prod) ─────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=songforge
S3_SECRET_ACCESS_KEY=songforge-secret
S3_BUCKET=songforge-audio
S3_REGION=auto
# Public/CDN base URL audio is served from — the URL the BROWSER fetches <audio> from.
# Leave this blank for local dev: docker-compose defaults it to the MinIO port published
# on your host (http://localhost:${MINIO_HOST_PORT}/${S3_BUCKET}), which the browser can
# reach and which tracks any port/bucket override. The audio bucket is made anonymously-
# readable at boot (S3_PUBLIC_BUCKET below), so browser playback works out of the box.
# In prod, set this to your public bucket / CDN base (e.g. https://cdn.songforge.app).
# NB: if you run WITHOUT docker-compose, blank falls back (in the app) to the internal
# S3_ENDPOINT_URL host (minio:9000), which the server can reach but a browser cannot.
S3_PUBLIC_BASE_URL=

# Browser-reachable endpoint used ONLY to SIGN presigned download URLs (issue #39, the
# GET /download "Save As {title}.mp3" button). A presigned GET's SigV4 signature covers
# the host, so it must be signed against the host the browser connects to — signing
# against the internal S3_ENDPOINT_URL (minio:9000) would 302 the browser to an
# unreachable host. Leave blank for local dev: docker-compose defaults it to the
# host-mapped MinIO (http://localhost:${MINIO_HOST_PORT}, NO bucket path — path-style
# addressing adds it). Leave blank in prod, where S3_ENDPOINT_URL (the R2 S3 endpoint)
# is already browser-reachable. NB: without docker-compose, set this to the MinIO host
# you expose to the browser, else downloads 302 to minio:9000.
S3_PRESIGN_ENDPOINT_URL=

# Grant anonymous read on the audio bucket at boot (public bucket + CDN model). Set
# false to keep it private (e.g. serving via signed URLs). Best-effort on R2.
S3_PUBLIC_BUCKET=true

# ── Static library seeded at boot ─────────────────────────────────────────────
STATIC_LIBRARY_DIR=/app/static-library

# ── Generation API (fault-injectable simulator locally; real MusicGPT in prod) ─
MUSICGPT_BASE_URL=http://simulator:8080
MUSICGPT_API_KEY=

# ── MusicGPT simulator (dev/test only; SIM_-prefixed, read by SimulatorSettings) ─
# Completion-webhook delay in seconds; 0 = instant mode for fast UI iteration. A request
# can override per-call with the X-Sim-Delay-Seconds header, and inject faults with the
# X-Sim-Fault header (webhook-never-arrives, url-expires-before-ingest, error, failed,
# delayed-webhook, duplicate-webhook, rate-limit-429).
SIM_WEBHOOK_DELAY_SECONDS=5

# ── Rate limits & concurrency (single source; toggle enforcement with one bool) ─
ENFORCE_RATE_LIMITS=true
ANON_DAILY_SONGS_PER_COOKIE=2
ANON_DAILY_SONGS_PER_IP=6
ACCOUNTS_PER_IP=2
AUTHED_DAILY_SONGS=10
PER_USER_CONCURRENT_JOBS=2
GLOBAL_GENERATION_CONCURRENCY=1
# Daily-counter window in seconds (issue #15). Lower it (e.g. 60) to watch quotas reset
# quickly while manually testing.
RATE_LIMIT_WINDOW_SECONDS=86400

# ── Abuse: client-IP resolution + bot check (issue #15) ───────────────────────
# Trusted forwarded header carrying the real client IP behind a proxy/LB. LEAVE BLANK
# for the direct socket peer -- a forwarded header is IGNORED unless this names it, so a
# client can't spoof its IP to dodge the per-IP cap. Set only behind a trusted proxy.
CLIENT_IP_HEADER=
# Phase-5 security fix (issue #19): docker-compose.yml sets this to X-Forwarded-For on
# the `web` service ONLY -- do not set it here / at this shared default. WARNING: only
# ever enable CLIENT_IP_HEADER=X-Forwarded-For when the proxy in front OVERWRITES the
# header with the real TCP peer (loadbalancer/nginx.conf does: `proxy_set_header
# X-Forwarded-For $remote_addr;`). If a proxy instead APPENDS to a client-supplied value
# (nginx's `$proxy_add_x_forwarded_for`, or an unconfigured edge), trusting the leftmost
# token lets any client spoof an arbitrary IP and bypass the per-IP rate cap entirely.
# See docs/deploy.md "Client IP / rate-limit trust" for the local + Railway verification
# steps.
# CLIENT_IP_HEADER=X-Forwarded-For
# Shared-secret bot-check gate on POST /create. BLANK token (default) DISABLES the check
# (local-dev seam). Set BOT_CHECK_TOKEN to a value to require the header on every create.
BOT_CHECK_HEADER=X-Bot-Check
BOT_CHECK_TOKEN=

# ── Identity (issue #12: signed-cookie anonymous identity) ────────────────────
# HMAC key signing the identity cookie (web/identity.py). MUST be overridden in
# prod -- a leaked/default secret lets a client forge another identity's cookie.
SESSION_SECRET=dev-insecure-change-me
IDENTITY_COOKIE_NAME=sf_uid
IDENTITY_COOKIE_MAX_AGE_SECONDS=31536000

# ── Generation job queue (issue #12) ───────────────────────────────────────────
# Longest prompt POST /create accepts before a 422.
PROMPT_MAX_LENGTH=2000
# Longest lyrics POST /create accepts before a 422 (same abuse vector as prompt).
LYRICS_MAX_LENGTH=5000
# Callback base URL sent as `webhook_url` on the generation create call; the
# receiving handler is a later issue -- #12 only sends a plausible, config-driven URL.
MUSICGPT_WEBHOOK_URL=http://web:8000/api/generation/webhook
# Redis semaphore keys (global + per-user in-flight generation caps).
SEMAPHORE_GLOBAL_KEY=sem:gen:global
SEMAPHORE_USER_KEY_PREFIX=sem:gen:user:
# Postgres LISTEN/NOTIFY channels: new-job wakes dispatch without polling;
# semaphore-release wakes a dispatcher that was waiting on a full cap;
# song-ready wakes the radio leader so a freshly-ready user song can interrupt
# a static filler (issue #14) instead of waiting for the poll/boundary.
JOBS_NEW_CHANNEL=new_job
SEMAPHORE_RELEASE_CHANNEL=sem_release
RADIO_READY_CHANNEL=song_ready
# Slow-poll backstop for the dispatch loop in case a NOTIFY is ever missed.
DISPATCH_POLL_BACKSTOP_SECONDS=5.0
# Backoff applied to a job's available_at on a 429/5xx/timeout requeue.
DISPATCH_REQUEUE_BACKOFF_SECONDS=5.0

# ── Radio leader election / worker lock connection tuning (issue #17, PRD #74) ─
# Postgres `tcp_user_timeout` (seconds) set on the radio leader's dedicated,
# unpooled advisory-lock connection, so a dead leader's session -- and therefore
# its lock -- is detected and released promptly. PRD target: ~10-15s failover.
WORKER_LOCK_TCP_USER_TIMEOUT_SECONDS=13

# ── Observability: local monitoring profile (issue #18, AC5) ──────────────────
# Only read by `docker compose --profile monitoring up` -- irrelevant to the
# default `docker compose up` workflow. See monitoring/README.md for the
# local/staging/prod env split.
# Host port mappings (loopback-only, see docker-compose.yml -- these are NEVER
# exposed on 0.0.0.0). postgres_exporter/redis_exporter publish no host port at
# all; Prometheus reaches them over the compose network by service name.
PROMETHEUS_HOST_PORT=59090
GRAFANA_HOST_PORT=59091
# REQUIRED to bring the monitoring profile up -- Grafana's container refuses to
# start with this unset (no insecure admin/admin default). Set a real local
# password here; never reuse it in staging/prod.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
# Anonymous Viewer access to Grafana. Off by default; opt in for local
# convenience only -- never enable on a staging/prod-reachable host.
GRAFANA_ANON_ENABLED=false
