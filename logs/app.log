  "lyrics_timestamped": "[{\"start\": 10400, \"end\": 33960, \"text\": \"[Verse]\", \"index\": 0}, {\"start\": 10400, \"end\": 14600, \"text\": \"The needle slides across the heavy black groove\", \"index\": 1}, {\"start\": 14640, \"end\": 16960, \"text\": \"Static crackles like a dry summer storm\", \"index\": 2}, {\"start\": 17400, \"end\": 21080, \"text\": \"We watched the previous spin fade into the dust\", \"index\": 3}, {\"start\": 21640, \"end\": 24720, \"text\": \"While the shadows grew long against the cabin wall\", \"index\": 4}, {\"start\": 25880, \"end\": 29560, \"text\": \"The stories told are buried in the sleeve\", \"index\": 5}, {\"start\": 29880, \"end\": 33960, \"text\": \"Waiting for a needle to find the vein of truth\", \"index\": 6}, {\"start\": 34920, \"end\": 54640, \"text\": \"[Chorus]\", \"index\": 7}, {\"start\": 34920, \"end\": 37960, \"text\": \"Now give us the next song to carry the weight\", \"index\": 8}, {\"start\": 38640, \"end\": 42520, \"text\": \"Of a morning that hasn't found its color yet\", \"index\": 9}, {\"start\": 42640, \"end\": 45880, \"text\": \"Turn the page of the rolling mercury sea\", \"index\": 10}, {\"start\": 46360, \"end\": 49640, \"text\": \"And play the one that knows where we are headed\", \"index\": 11}, {\"start\": 49880, \"end\": 54640, \"text\": \"Beyond the broken fences of the tired world\", \"index\": 12}, {\"start\": 58120, \"end\": 81960, \"text\": \"[Verse]\", \"index\": 13}, {\"start\": 58120, \"end\": 61280, \"text\": \"Grandfather left his boots by the iron stove\", \"index\": 14}, {\"start\": 61880, \"end\": 64960, \"text\": \"His lungs filled with the ghosts of coal and pride\", \"index\": 15}, {\"start\": 65880, \"end\": 68960, \"text\": \"He never stayed for the final flickering note\", \"index\": 16}, {\"start\": 69360, \"end\": 73200, \"text\": \"He was always looking toward the rising ridge\", \"index\": 17}, {\"start\": 73360, \"end\": 76960, \"text\": \"Where the wind whistles a tune no man can own\", \"index\": 18}, {\"start\": 77400, \"end\": 81960, \"text\": \"Just a restless hum beneath the frozen ground\", \"index\": 19}, {\"start\": 82880, \"end\": 102680, \"text\": \"[Chorus]\", \"index\": 20}, {\"start\": 82880, \"end\": 85960, \"text\": \"Now give us the next song to carry the weight\", \"index\": 21}, {\"start\": 86640, \"end\": 90520, \"text\": \"Of a morning that hasn't found its color yet\", \"index\": 22}, {\"start\": 90640, \"end\": 93960, \"text\": \"Turn the page of the rolling mercury sea\", \"index\": 23}, {\"start\": 94400, \"end\": 97640, \"text\": \"And play the one that knows where we are headed\", \"index\": 24}, {\"start\": 97880, \"end\": 102680, \"text\": \"Beyond the broken fences of the tired world\", \"index\": 25}, {\"start\": 106160, \"end\": 129680, \"text\": \"[Bridge]\", \"index\": 26}, {\"start\": 106160, \"end\": 112640, \"text\": \"It is not about the melody we already memorized\", \"index\": 27}, {\"start\": 113120, \"end\": 117600, \"text\": \"Or the rhymes that fell like spent silver coins\", \"index\": 28}, {\"start\": 117640, \"end\": 121560, \"text\": \"It is the silence that follows the closing chord\", \"index\": 29}, {\"start\": 121640, \"end\": 125200, \"text\": \"The hunger for a sound that hasn't been named\", \"index\": 30}, {\"start\": 125400, \"end\": 129680, \"text\": \"Calling out from the throat of a brand new day\", \"index\": 31}, {\"start\": 131000, \"end\": 150240, \"text\": \"[Chorus]\", \"index\": 32}, {\"start\": 131000, \"end\": 133960, \"text\": \"Now give us the next song to carry the weight\", \"index\": 33}, {\"start\": 134640, \"end\": 138520, \"text\": \"Of a morning that hasn't found its color yet\", \"index\": 34}, {\"start\": 138640, \"end\": 142000, \"text\": \"Turn the page of the rolling mercury sea\", \"index\": 35}, {\"start\": 142400, \"end\": 145640, \"text\": \"And play the one that knows where we are headed\", \"index\": 36}, {\"start\": 145920, \"end\": 150240, \"text\": \"Beyond the broken fences of the tired world\", \"index\": 37}, {\"start\": 150760, \"end\": 169200, \"text\": \"[Chorus]\", \"index\": 38}, {\"start\": 150760, \"end\": 153920, \"text\": \"Give us the next song for the highway ahead\", \"index\": 39}, {\"start\": 154400, \"end\": 157960, \"text\": \"Where the asphalt bleeds into the golden horizon\", \"index\": 40}, {\"start\": 158400, \"end\": 161760, \"text\": \"Let the chords strike like a hammer on the anvil\", \"index\": 41}, {\"start\": 161960, \"end\": 165000, \"text\": \"And sing the verse that sets the prisoner free\", \"index\": 42}, {\"start\": 165440, \"end\": 169200, \"text\": \"Until the music is all that remains of the journey\", \"index\": 43}]"
}
