, \"index\": 17}, {\"start\": 98360, \"end\": 103400, \"text\": \"Searching for a substance that the senses cannot feel\", \"index\": 18}, {\"start\": 104360, \"end\": 109520, \"text\": \"The blueprint is a ghost that haunts the architecture plan\", \"index\": 19}, {\"start\": 110400, \"end\": 120960, \"text\": \"The mystery remains inside the spirit of a man\", \"index\": 20}, {\"start\": 127560, \"end\": 160400, \"text\": \"[Verse]\", \"index\": 21}, {\"start\": 127560, \"end\": 131920, \"text\": \"A merchant sells a map that leads to nowhere in the rain\", \"index\": 22}, {\"start\": 133080, \"end\": 138080, \"text\": \"The conductor counts the boxcars on a rusted ghost of train\", \"index\": 23}, {\"start\": 138800, \"end\": 143840, \"text\": \"You say that every trial is a lesson for the soul\", \"index\": 24}, {\"start\": 144480, \"end\": 149440, \"text\": \"But the broken pieces never make a decorated whole\", \"index\": 25}, {\"start\": 150360, \"end\": 154720, \"text\": \"The dictionary fails to find a name for how we stand\", \"index\": 26}, {\"start\": 156200, \"end\": 160400, \"text\": \"Gazing at the borders of a strange and hollow land\", \"index\": 27}, {\"start\": 161040, \"end\": 181760, \"text\": \"[Pre-Chorus]\", \"index\": 28}, {\"start\": 161040, \"end\": 165080, \"text\": \"The clock is ticking backwards in the hallway of the mind\", \"index\": 29}, {\"start\": 166880, \"end\": 171560, \"text\": \"Leaving all the certainty and heavy boots behind\", \"index\": 30}, {\"start\": 172200, \"end\": 176400, \"text\": \"The mirror shows a stranger with a familiar kind of gaze\", \"index\": 31}, {\"start\": 178200, \"end\": 181760, \"text\": \"Walking through the thicket of the autumn colored haze\", \"index\": 32}, {\"start\": 183800, \"end\": 216960, \"text\": \"[Chorus]\", \"index\": 33}, {\"start\": 183800, \"end\": 189480, \"text\": \"The compass needle flickers in the palm of every hand\", \"index\": 34}, {\"start\": 189720, \"end\": 193400, \"tex