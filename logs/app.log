uls go,\", \"start\": 88400, \"end\": 90160}, {\"index\": 21, \"text\": \"where the darkness takes its toll\", \"start\": 91200, \"end\": 93120}, {\"index\": 22, \"text\": \"in the heart of the city\", \"start\": 104400, \"end\": 106560}, {\"index\": 23, \"text\": \"a story unfolds where the broken find solid and tales\", \"start\": 107600, \"end\": 114640}, {\"index\": 24, \"text\": \"untold\", \"start\": 114800, \"end\": 115760}, {\"index\": 25, \"text\": \"This is ro a place of shattered dreams\", \"start\": 117360, \"end\": 121520}, {\"index\": 26, \"text\": \"in the depths of despair nothing's as it seems\", \"start\": 122960, \"end\": 128479}, {\"index\": 27, \"text\": \"where the broken souls go\", \"start\": 131760, \"end\": 133520}, {\"index\": 28, \"text\": \"where the darkness takes its tolling souls\", \"start\": 134560, \"end\": 142640}, {\"index\": 29, \"text\": \"go\", \"start\": 142640, \"end\": 142880}, {\"index\": 30, \"text\": \"out where the darkness takes its toll\", \"start\": 146320, \"end\": 149520}]"
