  "subtype": "lyrics_timestamped",
  "lyrics_timestamped": "[{\"start\": 18800, \"end\": 43760, \"text\": \"[Verse]\", \"index\": 0}, {\"start\": 18800, \"end\": 21120, \"text\": \"The blank page is a cold stretch of white sand\", \"index\": 1}, {\"start\": 23640, \"end\": 26320, \"text\": \"Waiting for the weight of a heavy hand\", \"index\": 2}, {\"start\": 28240, \"end\": 30120, \"text\": \"The ink is a river that refuses to flow\", \"index\": 3}, {\"start\": 30720, \"end\": 32560, \"text\": \"Looking for a place where the wild seeds grow\", \"index\": 4}, {\"start\": 32759, \"end\": 34960, \"text\": \"I picked up a stone from the edge of the town\", \"index\": 5}, {\"start\": 35120, \"end\": 37240, \"text\": \"Where the old iron fences are all falling down\", \"index\": 6}, {\"start\": 37640, \"end\": 39920, \"text\": \"There is no map for the road I must take\", \"index\": 7}, {\"start\": 41600, \"end\": 43760, \"text\": \"Just a shivering light on a dark timber lake\", \"index\": 8}, {\"start\": 44720, \"end\": 68240, \"text\": \"[Verse]\", \"index\": 9}, {\"start\": 44720, \"end\": 47480, \"text\": \"The clock on the wall has a hollow metallic sound\", \"index\": 10}, {\"start\": 49560, \"end\": 52200, \"text\": \"Counting the footsteps of ghosts on the ground\", \"index\": 11}, {\"start\": 53920, \"end\": 56120, \"text\": \"I\u2019m carving a name into the bark of a tree\", \"index\": 12}, {\"start\": 56600, \"end\": 58480, \"text\": \"Trying to remember what used to be free\", \"index\": 13}, {\"start\": 58800, \"end\": 60680, \"text\": \"The shadows are long and the shadows are deep\", \"index\": 14}, {\"start\": 61000, \"end\": 63640, \"text\": \"Like secrets a mountain is trying to keep\", \"index\": 15}, {\"start\": 63680, \"end\": 65519, \"text\": \"The first line is written in dust and in bone\", \"index\": 16}, {\"start\": 65880, \"end\": 68240, \"text\": \"A message sent out to the vast and unknown\", \"index\": 17}, {\"start\": 69840, \"end\": 84600, \"text\": \"[Chorus]\", \"index\": 18}, {\"start\": 69840, \"end\": 72520, \"text\": \"It is a long way from the start to the end\", \"index\": 19}, {\"start\": 72920, \"end\": 75120, \"text\": \"Around every corner and every sharp bend\", \"index\": 20}, {\"start\": 75280, \"end\": 77200, \"text\": \"The wind is a prophet with nothing to say\", \"index\": 21}, {\"start\": 77480, \"end\": 79640, \"text\": \"But blow all the ashes of yesterday away\", \"index\": 22}, {\"start\": 79840, \"end\": 82000, \"text\": \"Yes the sky is a mirror of silver and lead\", \"index\": 23}, {\"start\": 82360, \"end\": 84600, \"text\": \"Reflecting the visions inside of my head\", \"index\": 24}, {\"start\": 86280, \"end\": 101080, \"text\": \"[Chorus]\", \"index\": 25}, {\"start\": 86280, \"end\": 89240, \"text\": \"It is a long way from the start to the end\", \"index\": 26}, {\"start\": 89400, \"end\": 91600, \"text\": \"Around every corner and every sharp bend\", \"index\": 27}, {\"start\": 91760, \"end\": 93680, \"text\": \"The wind is a prophet with nothing to say\", \"index\": 28}, {\"start\": 93960, \"end\": 96080, \"text\": \"But blow all the ashes of yesterday away\", \"index\": 29}, {\"start\": 96320, \"end\": 98440, \"text\": \"Yes the sky is a mirror of silver and lead\", \"index\": 30}, {\"start\": 98800, \"end\": 101080, \"text\": \"Reflecting the visions inside of my head\", \"index\": 31}, {\"start\": 103160, \"end\": 122000, \"text\": \"[Bridge]\", \"index\": 32}, {\"start\": 103160, \"end\": 105960, \"text\": \"They told me the truth was a jewel in a box\", \"index\": 33}, {\"start\": 106000, \"end\": 108160, \"text\": \"Safe from the hammers and hidden by locks\", \"index\": 34}, {\"start\": 108240, \"end\": 110080, \"text\": \"But I found the key in a bucket of rain\", \"index\": 35}, {\"start\": 110720, \"end\": 112800, \"text\": \"Tied to the wheels of a slow moving train\", \"index\": 36}, {\"start\": 112920, \"end\": 115240, \"text\": \"The morning is coming but the night is still near\", \"index\": 37}, {\"start\": 115400, \"end\": 117320, \"text\": \"Whispering things that I don't want to hear\", \"index\": 38}, {\"start\": 117480, \"end\": 119600, \"text\": \"So I buckle my boots and I sharpen my sight\", \"index\": 39}, {\"start\": 120120, \"end\": 122000, \"text\": \"Walking straight into the belly of light\", \"index\": 40}, {\"start\": 122360, \"end\": 141080, \"text\": \"[Verse]\", \"index\": 41}, {\"start\": 122360, \"end\": 124320, \"text\": \"The melody crawls like a vine up the wall\", \"index\": 42}, {\"start\": 124840, \"end\": 126680, \"text\": \"Catching the leaves just before they can fall\", \"index\": 43}, {\"start\": 126880, \"end\": 129479, \"text\": \"I\u2019ve seen the poets who stood in the queue\", \"index\": 44}, {\"start\": 129520, \"end\": 131400, \"text\": \"Trading their stories for something brand new\", \"index\": 45}, {\"start\": 131560, \"end\": 133800, \"text\": \"But I\u2019ll keep my tattered and weathered old coat\", \"index\": 46}, {\"start\": 133960, \"end\": 136080, \"text\": \"And the jagged red lines of the verses I wrote\", \"index\": 47}, {\"start\": 136280, \"end\": 138640, \"text\": \"The beginning is always a gamble with time\", \"index\": 48}, {\"start\": 138960, \"end\": 141080, \"text\": \"Searching for reason and searching for rhyme\", \"index\": 49}, {\"start\": 141280, \"end\": 159960, \"text\": \"[Verse]\", \"index\": 50}, {\"start\": 141280, \"end\": 143120, \"text\": \"The wheels of the wagon are beginning to creak\", \"index\": 51}, {\"start\": 143320, \"end\": 145640, \"text\": \"While the strong men are silent and the loud men are weak\", \"index\": 52}, {\"start\": 145680, \"end\": 147880, \"text\": \"I\u2019m casting a net in a dry dusty well\", \"index\": 53}, {\"start\": 148360, \"end\": 150440, \"text\": \"Hoping to find what the stars have to tell\", \"index\": 54}, {\"start\": 150560, \"end\": 152880, \"text\": \"The first song is sung by a bird on a wire\", \"index\": 55}, {\"start\": 