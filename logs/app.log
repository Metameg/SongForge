  "lyrics_timestamped": "[{\"start\": 12640, \"end\": 32360, \"text\": \"[Verse]\", \"index\": 0}, {\"start\": 12640, \"end\": 15280, \"text\": \"The needle slides back to the very first mark\", \"index\": 1}, {\"start\": 15800, \"end\": 18240, \"text\": \"The rusted machine turns once more in the dark\", \"index\": 2}, {\"start\": 18960, \"end\": 21480, \"text\": \"You say it like prayer or a curse on the tongue\", \"index\": 3}, {\"start\": 22120, \"end\": 24560, \"text\": \"To fetch back the bells that were already rung\", \"index\": 4}, {\"start\": 25240, \"end\": 28360, \"text\": \"The shadow is stretching across the floorboards\", \"index\": 5}, {\"start\": 28400, \"end\": 32360, \"text\": \"As the dust makes a choir of the old broken chords\", \"index\": 6}, {\"start\": 33280, \"end\": 51360, \"text\": \"[Verse]\", \"index\": 7}, {\"start\": 33280, \"end\": 35640, \"text\": \"A circular road where the gravel is gray\", \"index\": 8}, {\"start\": 36280, \"end\": 38880, \"text\": \"You trade in tomorrow for one yesterday\", \"index\": 9}, {\"start\": 39480, \"end\": 42280, \"text\": \"The clock on the mantle is holding its breath\", \"index\": 10}, {\"start\": 42400, \"end\": 45080, \"text\": \"Like a gambler who plays for a life or a death\", \"index\": 11}, {\"start\": 45760, \"end\": 48520, \"text\": \"You walk through the doorway you exited then\", \"index\": 12}, {\"start\": 48720, \"end\": 51360, \"text\": \"Just to stand in the quiet and say it again\", \"index\": 13}, {\"start\": 51800, \"end\": 71080, \"text\": \"[Chorus]\", \"index\": 14}, {\"start\": 51800, \"end\": 54720, \"text\": \"Oh the heavy wheel rolls on the soft river mud\", \"index\": 15}, {\"start\": 55080, \"end\": 57920, \"text\": \"There is iron and clover inside of the blood\", \"index\": 16}, {\"start\": 58240, \"end\": 60880, \"text\": \"It is built in the bone and it lives in the eye\", \"index\": 17}, {\"start\": 61600, \"end\": 64040, \"text\": \"To watch every summer eventually die\", \"index\": 18}, {\"start\": 64480, \"end\": 67760, \"text\": \"But you keep on reaching for what you have lost\", \"index\": 19}, {\"start\": 67880, \"end\": 71080, \"text\": \"No matter the winter and no matter the cost\", \"index\": 20}, {\"start\": 77480, \"end\": 99480, \"text\": \"[Verse]\", \"index\": 21}, {\"start\": 77480, \"end\": 79880, \"text\": \"The prophets are sleeping on benches of stone\", \"index\": 22}, {\"start\": 80320, \"end\": 83440, \"text\": \"While the king counts the seeds that he never has sown\", \"index\": 23}, {\"start\": 83680, \"end\": 86320, \"text\": \"The letter is signed but the ink is still wet\", \"index\": 24}, {\"start\": 86640, \"end\": 89440, \"text\": \"With the things that the memory cannot forget\", \"index\": 25}, {\"start\": 89960, \"end\": 92640, \"text\": \"A circle is drawn where the straight line should run\", \"index\": 26}, {\"start\": 92920, \"end\": 99480, \"text\": \"Underneath the cold stare of a tired out sun\", \"index\": 27}, {\"start\": 99880, \"end\": 117880, \"text\": \"[Verse]\", \"index\": 28}, {\"start\": 99880, \"end\": 101920, \"text\": \"The boots on the porch have a long way to go\", \"index\": 29}, {\"start\": 102440, \"end\": 105040, \"text\": \"But the path only leads to the valleys you know\", \"index\": 30}, {\"start\": 105560, \"end\": 108240, \"text\": \"There is nothing quite new in the way that we part\", \"index\": 31}, {\"start\": 108720, \"end\": 111600, \"text\": \"It is just the old hunger that gnaws at the heart\", \"index\": 32}, {\"start\": 112120, \"end\": 114720, \"text\": \"The mirror is clouded and cracked at the rim\", \"index\": 33}, {\"start\": 115040, \"end\": 117880, \"text\": \"But the ghost in the glass is still looking for him\", \"index\": 34}, {\"start\": 118400, \"end\": 133600, \"text\": \"[Pre-Chorus]\", \"index\": 35}, {\"start\": 118400, \"end\": 121320, \"text\": \"The rain on the roof has a familiar sound\", \"index\": 36}, {\"start\": 121360, \"end\": 124720, \"text\": \"Like the turning of wheels on a hollowed out ground\", \"index\": 37}, {\"start\": 124760, \"end\": 128000, \"text\": \"The words are all spent but the feeling remains\", \"index\": 38}, {\"start\": 128039, \"end\": 133600, \"text\": \"Running like water through silver-lined veins\", \"index\": 39}, {\"start\": 134200, \"end\": 153200, \"text\": \"[Chorus]\", \"index\": 40}, {\"start\": 134200, \"end\": 136840, \"text\": \"Oh the heavy wheel rolls on the soft river mud\", \"index\": 41}, {\"start\": 137160, \"end\": 139960, \"text\": \"There is iron and clover inside of the blood\", \"index\": 42}, {\"start\": 140320, \"end\": 142960, \"text\": \"It is built in the bone and it lives in the eye\", \"index\": 43}, {\"start\": 143680, \"end\": 146560, \"text\": \"To watch every summer eventually die\", \"index\": 44}, {\"start\": 146600, \"end\": 149760, \"text\": \"But you keep on reaching for what you have lost\", \"index\": 45}, {\"start\": 149800, \"end\": 153200, \"text\": \"No matter the winter and no matter the cost\", \"index\": 46}]"
